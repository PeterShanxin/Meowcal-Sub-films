{
  "name": "meowcal-sub-films",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "studio:reading-test": "remotion studio reading-test/src/index.tsx --public-dir=reading-test/public --no-open",
    "audio:reading-test": "python reading-test/audio/score.py",
    "render:reading-test": "remotion render reading-test/src/index.tsx ReadingTest reading-test/out/meowcal-reading-test-v1.mp4 --public-dir=reading-test/public",
    "cover:reading-test": "remotion still reading-test/src/index.tsx ReadingTestCover reading-test/out/cover-v1.png --public-dir=reading-test/public",
    "studio:fable-vs-astra": "remotion studio fable-vs-astra/src/index.tsx --public-dir=fable-vs-astra/public --no-open",
    "audio:fable-vs-astra": "python fable-vs-astra/audio/build.py && node fable-vs-astra/audio/score/render-score.mjs fable-vs-astra/audio/score.json fable-vs-astra/public/audio/sfx.wav",
    "render:fable-vs-astra": "remotion render fable-vs-astra/src/index.tsx FableVsAstra fable-vs-astra/out/fable-vs-astra-v10.mp4 --public-dir=fable-vs-astra/public",
    "cover:fable-vs-astra": "remotion still fable-vs-astra/src/index.tsx FableVsAstraCover fable-vs-astra/out/cover.png --public-dir=fable-vs-astra/public",
    "assets:sub2-remix": "python sub2-remix/scripts/fetch_assets.py",
    "audio:sub2-remix": "python sub2-remix/audio/build.py",
    "studio:sub2-remix": "remotion studio sub2-remix/src/index.tsx --public-dir=sub2-remix/public --no-open",
    "render:sub2-remix": "remotion render sub2-remix/src/index.tsx Sub2RemixSilent sub2-remix/out/picture.mp4 --public-dir=sub2-remix/public --muted --crf=19 && ffmpeg -v error -y -i sub2-remix/out/picture.mp4 -i sub2-remix/public/audio/mix.wav -map 0:v -map 1:a -c:v copy -c:a aac -b:a 256k -ar 48000 -movflags +faststart -t 50.9 sub2-remix/out/meowcal-sub-2-remix-v10.mp4",
    "cover:sub2-remix": "remotion still sub2-remix/src/index.tsx Sub2RemixCover sub2-remix/out/cover-v10.png --public-dir=sub2-remix/public",
    "sync:sub2-remix": "python -I sub2-remix/audio/check_sync.py sub2-remix/out/meowcal-sub-2-remix-v10.mp4",
    "typecheck": "tsc --noEmit",
    "studio:15s": "remotion studio launch-15s/src/index.ts --public-dir=launch-15s/public",
    "studio:cat-drama": "remotion studio cat-drama/src/index.ts --public-dir=cat-drama/public",
    "audio:15s": "python launch-15s/audio/synth.py",
    "audio:cat-drama": "python cat-drama/audio/drama.py",
    "render:15s": "remotion render launch-15s/src/index.ts LaunchFilm launch-15s/out/meowcal-sub-launch-film.mp4 --public-dir=launch-15s/public"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
